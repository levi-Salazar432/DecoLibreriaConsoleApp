<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.Deco.controller.EditorialFXController" styleClass="editorial-root" stylesheets="@editorialview.css">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10" styleClass="form-container">
            <padding><Insets right="20" /></padding>
            <Label styleClass="section-title" text="Registrar Editorial" />
            <TextField fx:id="txtNit" promptText="Nit" styleClass="form-text" />
            <TextField fx:id="txtNombreEditorial" promptText="Nombre" styleClass="form-text" />
            <TextField fx:id="txtTelefonoEditorial" promptText="Telefono Editorial" styleClass="form-text" />
            <TextField fx:id="txtDireccionEditorial" promptText="Direccion Editorial" styleClass="form-text" />
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Guardar" styleClass="primary-button" />
                <Button onAction="#handleLimpiar" prefWidth="120" text="Limpiar" styleClass="primary-button" />
            </HBox>
            <Label fx:id="lblMensaje" styleClass="message-label" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label styleClass="section-title" text="Lista Editorial" />
            <TableView fx:id="tablaEditoriales" styleClass="editorial-table">
                <columns>
                    <TableColumn fx:id="colNit" prefWidth="75.0" text="NIT" />
                    <TableColumn fx:id="colNombre" prefWidth="101.0" text="Nombre Editorial" />
                    <TableColumn fx:id="colTelefono" prefWidth="112.0" text="Telefono editorial" />
                    <TableColumn fx:id="colDireccion" prefWidth="120.0" text="Direccion editorial" />
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button onAction="#handleActualizar" text="Actualizar Tabla" styleClass="table-button" />
                <Button onAction="#handleVolver" text="Volver al Menú" styleClass="table-button" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
