<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.Deco.controller.AutoresLibroFXController"
            stylesheets="@Style/autoreslibro.css">

    <top>

        <Label text="Autores Libro"
               styleClass="titulo"
               BorderPane.alignment="CENTER">

            <padding>
                <Insets top="20" bottom="20"/>
            </padding>

        </Label>

    </top>

    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="20"
                        right="30"
                        bottom="20"
                        left="30"/>
            </padding>

            <GridPane hgap="10" vgap="10">

                <Label text="ID Relación:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="txtIdAutorLibro"
                           editable="false"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>


                <Label text="ID Autor:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="txtIdAutor"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>


                <Label text="ISBN:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="txtIsbn"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

            </GridPane>


            <HBox spacing="10">

                <Button text="Guardar"
                        onAction="#handleGuardar"/>

                <Button text="Limpiar"
                        onAction="#handleLimpiar"/>

                <Button text="Actualizar"
                        onAction="#handleActualizar"/>

                <Button text="Volver"
                        onAction="#handleVolver"/>

            </HBox>


            <Label fx:id="lblMensaje"/>


            <TableView fx:id="tablaAutoresLibro"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colID"
                                 text="ID Relación"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colIdAutor"
                                 text="ID Autor"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colIsbn"
                                 text="ISBN"
                                 prefWidth="200"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>