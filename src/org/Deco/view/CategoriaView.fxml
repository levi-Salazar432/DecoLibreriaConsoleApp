<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@CategoriaView.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.Deco.controller.CategoriaFXController">
<padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
 
    <left>
<VBox maxWidth="300" minWidth="300" spacing="10">
<padding><Insets right="20" /></padding>
<Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Categoría" />
<TextField fx:id="txtidCategoria" disable="true" promptText="ID Categoría (Automático)" />
<TextField fx:id="txtnombreCategoria" promptText="Nombre de Categoría" />
<HBox spacing="10">
<Button fx:id="btnGuardar" onAction="#handleGuardar" prefWidth="120" text="Guardar" />
<Button onAction="#handleLimpiar" prefWidth="120" text="Limpiar" />
</HBox>
<Label fx:id="lblMensaje" />
</VBox>
</left>
 
    <center>
<VBox spacing="10">
<Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Categorías" />
<TableView fx:id="tablaCategoria">
    
    
<columns>
        <TableColumn fx:id="colId" prefWidth="100" text="ID" />
        
        <TableColumn fx:id="colNombre" prefWidth="300" text="Nombre de Categoría" />
</columns>


</TableView>
<HBox spacing="10">
<Button onAction="#handleActualizar" text="Actualizar Tabla" />
<Button onAction="#handleVolver" text="Volver al Menú" />
</HBox>
</VBox>
</center>
</BorderPane>
