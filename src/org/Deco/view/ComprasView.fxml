<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/21.0.1"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.Deco.controller.ComprasFXController"
    styleClass="cliente-root"
    stylesheets="@style/comprasview.css">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    <left>
        <VBox
            maxWidth="300"
            minWidth="300"
            spacing="10"
            styleClass="form-container">
            <padding>
                <Insets right="20" />
            </padding>
            <Label
                styleClass="section-title"
                text="Registrar Compra" />
            <TextField
                fx:id="txtNoCompra"
                promptText="No. Compra"
                styleClass="form-text" />
            <TextField
                fx:id="txtTotalCompra"
                promptText="Total Compra"
                styleClass="form-text" />
            <TextField
                fx:id="txtCui"
                promptText="CUI Cliente"
                styleClass="form-text" />
            <HBox spacing="10">
                <Button
                    onAction="#handleGuardar"
                    prefWidth="120"
                    text="Guardar"
                    styleClass="primary-button" />
                <Button
                    onAction="#handleLimpiar"
                    prefWidth="120"
                    text="Limpiar"
                    styleClass="primary-button" />
            </HBox>
            <Label
                fx:id="lblMensaje"
                styleClass="message-label" />
        </VBox>
    </left>
    <center>
        <VBox spacing="10">
            <Label
                styleClass="section-title"
                text="Lista de Compras" />
            <TableView
                fx:id="tablaCompras"
                styleClass="client-table">
                <columns>
                    <TableColumn
                        fx:id="colNoCompra"
                        prefWidth="90"
                        text="No. Compra" />
                    <TableColumn
                        fx:id="colFechaCompra"
                        prefWidth="170"
                        text="Fecha y Hora" />
                    <TableColumn
                        fx:id="colTotalCompra"
                        prefWidth="120"
                        text="Total" />
                    <TableColumn
                        fx:id="colCui"
                        prefWidth="140"
                        text="CUI Cliente" />
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button
                    onAction="#handleActualizar"
                    text="Actualizar Tabla"
                    styleClass="table-button" />
                <Button
                    onAction="#handleVolver"
                    text="Volver al Menú"
                    styleClass="table-button" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
