<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.Deco.controller.AutorFXController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding><Insets right="20" /></padding>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Autor" />
            <TextField fx:id="txtIdAutor" promptText="ID" />
            <TextField fx:id="txtNombre" promptText="Nombre" />
            <TextField fx:id="txtApellido" promptText="Apellido" />
            <TextField fx:id="txtNacionalidad" promptText="Nacionalidad" />
         <TextField fx:id="txtBiografia" promptText="Biografia" />
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Guardar" />
                <Button onAction="#handleLimpiar" prefWidth="120" text="Limpiar" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Autores" />
            <TableView fx:id="tablaAutores">
                <columns>
                    <TableColumn prefWidth="120" text="ID">
                        <cellValueFactory>
                            <PropertyValueFactory property="idAutor" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="140" text="Nombre">
                        <cellValueFactory>
                            <PropertyValueFactory property="nombreAutor" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="140" text="Apellido">
                        <cellValueFactory>
                            <PropertyValueFactory property="apellidoAutor" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="200" text="Nacionalidad">
                        <cellValueFactory>
                            <PropertyValueFactory property="nacionalidad" />
                        </cellValueFactory>
                    </TableColumn>
               <TableColumn prefWidth="200" text="Biografia">
                  <cellValueFactory>
                     <PropertyValueFactory property="biografia" />
                  </cellValueFactory>
               </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button onAction="#handleActualizar" text="Actualizar Tabla" />
                <Button onAction="#handleVolver" text="Volver al Menú" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
